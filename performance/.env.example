# performance/.env.example
#
# Copy to performance/.env and fill in real values before running the donation
# mutation load test.
#
#   cp performance/.env.example performance/.env
#   # Edit performance/.env with your values
#   source performance/.env
#   artillery run performance/donation-mutation-load-test.yml \
#     --output performance/results/donation-mutation-$(date +%Y%m%d-%H%M%S).json
#
# Do NOT commit performance/.env — it is listed in .gitignore because it may
# contain a real JWT token.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the graphql-api service (no trailing slash)
GRAPHQL_URL=http://localhost:4000

# JWT bearer token for an authenticated test account.
# Obtain via the `authenticate` mutation or your test-seed script.
# The recordContribution mutation requires authentication (context.user check).
# If left empty the mutation will return "Authentication required" GraphQL errors
# and the error counters will spike — auth failures are categorised separately
# from RPC/rate-limit failures in the Artillery report.
AUTH_TOKEN=

# Soroban contract address (C... format) of an active campaign that has
# at least one real on-chain contribution from CONTRIBUTOR_ADDR.
# Against a local stellar/quickstart node you can create one with:
#   ./scripts/deploy.sh <CREATOR_ADDR> <TOKEN_ADDR> 1000 <DEADLINE> 10 \
#       "Load Test Campaign" "Perf test" null
CAMPAIGN_ID=PLACEHOLDER_CAMPAIGN_CONTRACT_ID

# Stellar public key (G... format) of the contributor account.
# Must have called `contribute(CAMPAIGN_ID, amount)` on-chain at least once
# before running the load test so the view call succeeds.
CONTRIBUTOR_ADDR=GAAZI4TCR3TY5OJHCTJC2A4QSY6CJWJH5IAJTGKIN2ER7LBNVKOCCWN
