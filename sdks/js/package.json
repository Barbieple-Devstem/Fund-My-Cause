  },
  "dependencies": {
    "@fund-my-cause/types": "file:../../packages/types"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^14.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "crowdfunding",
    "fund-my-cause"
  ],
  "license": "MIT"
}
