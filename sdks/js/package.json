{
  "name": "@fund-my-cause/sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for Fund-My-Cause Soroban contracts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "docs": "typedoc",
